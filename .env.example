# Copy to .env.local and fill in what you need. All variables are optional.

# Enables the AI-assessed checks (logo lockup, icon style, plain language, ...).
ANTHROPIC_API_KEY=
# Needed only with an organization-level key (not scoped to a workspace): the workspace to use.
# ANTHROPIC_WORKSPACE_ID=
# DBIM_AI_MODEL=claude-opus-5-5

# Or run the AI checks through Claude in Amazon Bedrock instead of the Claude API.
# Auth uses AWS_BEARER_TOKEN_BEDROCK (a Bedrock API key), AWS_PROFILE, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY,
# or the default AWS credential chain. The model ID gets the `anthropic.` prefix automatically.
# DBIM_AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=

# WORKER_CONCURRENCY=2
# PAGE_CONCURRENCY=3
# SCAN_TIMEOUT_MS=900000
# DBIM_DATA_DIR=./data
# APP_ORIGIN=https://dbim.example.org

# Browser used for scans: chrome (default, your installed Google Chrome), msedge or chromium.
# DBIM_BROWSER=chrome
# Show browser windows while scanning (local use only).
# DBIM_HEADED=1

# Scanning localhost / private-network URLs. Default: allowed with `npm run dev` and the CLI,
# blocked with `npm start`. 1 = always allow, 0 = always block. Keep it off on a public server.
# ALLOW_PRIVATE_URLS=0
